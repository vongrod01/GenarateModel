<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="css/index.css">
    <link rel="stylesheet" href="css/global.css">
    <link rel="stylesheet" href="bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" type="image/x-icon" href="/img/icon-title.ico">
    <!-- <script src="chart.js/dist/chart.umd.js"></script> -->
    <script src="jquery/dist/jquery.min.js"></script>
    <script src="bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> -->

    <title>Genarate MVC</title>
</head>

<body id="my-body">
    <header class="mb-2" id="pnlHeader">
        <span id="txtHeader">
            <%=titleHeader%>
        </span>
    </header>
    <div class="box-shadow4 m-1 mb-2 rounded-2 p-2 d-flex justify-content-center" id="pnlSelect">
        <div class="w-75">

            <div class="d-flex justify-content-center mb-2">




                <div class="input-group me-2" style="width: 33%;">
                    
                    <span for="selDatabaseProvider" class="input-group-text span-layout search-border text-end"
                        style="width: 120px;">
                        
                        
                        Provider</span>
                    <select class="form-select search-border" name="selDatabaseProvider" id="selDatabaseProvider">
                        <option value="mssql" selected>Microsoft SQL Server</option>
                        <option value="mysql">MySQL</option>
                        <option value="postgresql">PostgreSQL</option>
                    </select>
                </div>

                <div class="input-group me-2" style="width: 33%;">
                    <span for="edtHost" class="input-group-text span-layout search-border text-end"
                        style="width: 120px;">Host</span>
                    <input type="text" class="form-control search-border" name="edtHost" value="192.168.100.197"
                        id="edtHost" />
                </div>
                <div class="input-group me-2" style="width: 33%;">
                    <span for="edtPort" class="input-group-text span-layout search-border text-end"
                        style="width: 80px;">Port</span>
                    <input type="number" class="form-control search-border" name="edtPort" value=3306 id="edtPort" />
                </div>



            </div>

            <div class="d-flex justify-content-center">

                <div class="input-group me-2" style="width: 33%;">
                    <span for="edtUser" class="input-group-text span-layout search-border text-end"
                        style="width: 120px;">User</span>
                    <input type="text" class="form-control search-border" name="edtUser" value="adisorn.vo"
                        id="edtUser" />
                </div>
                <div class="input-group me-2" style="width: 33%;">
                    <span for="edtPassword" class="input-group-text span-layout search-border text-end"
                        style="width: 120px;">Password</span>
                    <input type="password" class="form-control search-border" name="edtPassword" value="vongrod01"
                        id="edtPassword" />
                </div>
                <div class="input-group me-2" style="width: 33%;">


                </div>
            </div>
        </div>

      

        <div class="my-btn h-100" style="align-self: center;" onclick="connectDB()">
            <h4 style="align-self: center;"><i class="bi bi-database-fill-check me-1"></i>Connect</h4>
        </div>


    </div>
    <div class="m-1 mb-2 p-2 d-flex" id="pnlExport">
        <div class="input-group me-1" style="width: 25%;">
            <span for="selProgramming"
                class="input-group-text span-layout search-border text-end">Framework/Programming</span>
            <select class="form-select search-border" name="selProgramming" id="selProgramming">
                <option value="nodejs" selected>Node.js</option>
                <option value="laravel">Laravel 8</option>
                <option value="codeigniter4">Codeigniter 4</option>
                <option value="python">Python</option>
                <option value="javascript">JavaScript</option>
            </select>
        </div>

        <div class="my-btn" id="btnExportConnectionDB"><i class="bi bi-download me-1"></i>Connection DB</div>
        
        
        <div class="my-btn" id="btnExportBaseClass"><i class="bi bi-download me-1"></i>Model(Base)</div>
        
        <div class="my-btn" id="btnExportVO_EXE"><i class="bi bi-download me-1"></i>Model(VO/EXE)</div>
       
        <div class="my-btn" id="btnExportView"><i class="bi bi-download me-1"></i>View</div>
        
        <div class="my-btn" id="btnExportControl"><i class="bi bi-download me-1"></i>Controller</div>
        
        <div class="my-btn" id="btnExportStoreProce"><i class="bi bi-download me-1"></i>Store Procedure</div>
        
        <!-- <button class="my-button" id="btn">Button</button> -->
    </div>
    <div class="box-shadow4 mb-2 m-1 rounded-2 p-2 d-flex justify-content-center" id="pnlContent">
        <div class="tb-content">
            <table id="tbDatabaseList" class="table table-striped table-bordered table-hover w-100">
                <thead class="position-sticky top-0">
                    <tr>
                        <th class="text-center align-middle" rowspan="3">Database</th>
                    </tr>
                </thead>
                <tbody>

                </tbody>
            </table>
        </div>
        <div class="ps-3 tb-content">
            <table id="tbTableList" class="table table-striped table-bordered table-hover w-100">
                <thead class="position-sticky top-0">
                    <tr>

                        <th class="text-center align-middle">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="" id="chkSelectAll">
                            </div>
                        </th>
                        <th class="text-center align-middle" rowspan="2">Table</th>
                    </tr>



                </thead>
                <tbody>

                </tbody>
            </table>
        </div>
        <div class="ps-3 tb-content">
            <table id="tbTableDesciption" class="table table-striped table-bordered table-hover w-100">
                <thead class="position-sticky top-0">
                    <tr>
                        <th class="text-center align-middle" colspan="4">Field</th>

                    </tr>
                    <tr>
                        <th class="text-center align-middle">Name</th>
                        <th class="text-center align-middle">Type</th>
                        <th class="text-center align-middle">Type Define</th>
                        <th class="text-center align-middle">Size</th>
                    </tr>

                </thead>
                <tbody>

                </tbody>
            </table>
        </div>
    </div>
    <footer>
        <span class="me-2 ps-1 pe-1" id="txtFooter">
            Developed by <%=developer%> [version <%=version%>]
        </span>
    </footer>

</body>
